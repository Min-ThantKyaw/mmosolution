model Post {
  id          String   @id @default(uuid())

  title       String
  slug        String   @unique
  content     String

  thumbnail   String?

  status      PostStatus @default(DRAFT)

  viewCount   Int @default(0)

  authorId    String
  author      User @relation(fields: [authorId], references: [id])


  comments    Comment[]
  // bookmarks   Bookmark[]
  // views       PostView[]

  // topics      PostTopic[]


  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  BANNED
}