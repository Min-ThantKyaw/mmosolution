# Server
PORT=4000
# Bind address — 0.0.0.0 is required on Render/Railway, fine for local dev too
HOST=0.0.0.0

# PostgreSQL connection string (Prisma driver adapter)
DATABASE_URL=postgresql://blog:blog@localhost:5434/blog

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=3600

# Comma-separated list of allowed CORS origins (the frontend URL(s))
CORS_ORIGIN=http://localhost:5173
