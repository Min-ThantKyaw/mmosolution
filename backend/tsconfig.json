{
  "compilerOptions": {
    "target": "ES2022",                          /* Specify ECMAScript target version */
    "module": "NodeNext",                        /* Required for modern Node.js ESM resolution */
    "moduleResolution": "NodeNext",              /* Required to match module settings */
    "lib": ["ES2022"],                           /* Specify library files to be included */
    "outDir": "./dist",                          /* Redirect output structure to the directory */
    "rootDir": "./src",                          /* Point to the source directory */
    "strict": true,                              /* Enable all strict type-checking options */
    "esModuleInterop": true,                     /* Emits additional JavaScript to ease importing CommonJS modules */
    "skipLibCheck": true,                        /* Skip type checking of declaration files */
    "forceConsistentCasingInFileNames": true     /* Disallow inconsistently-cased references to the same file */
  },
  "include": ["src/**/*"]                       /* Include all files inside the src folder */
}
